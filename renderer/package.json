{
  "name": "md-viewer-renderer",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Persistent local Markdown renderer for md-viewer.nvim",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node src/main.js",
    "test": "node --test --test-concurrency=2 --test-timeout=90000 ../tests/node/*.test.js"
  },
  "dependencies": {
    "highlight.js": "11.11.1",
    "markdown-it": "14.3.0",
    "markdown-it-task-lists": "2.1.1",
    "playwright": "1.62.1",
    "sanitize-html": "2.17.6"
  }
}
